{
  "name": "@lifo123/library",
  "version": "2.0.5",
  "sideEffects": false,
  "description": "Lifo library",
  "type": "module",
  "author": "Lifo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lifo123/lifo-library.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js",
      "require": "./dist/stores/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./styles/*": {
      "import": "./dist/styles/*",
      "require": "./dist/styles/*"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "deploy": "pnpm run build && npm publish --access public"
  },
  "dependencies": {
    "nanoid": "^5.1.11"
  },
  "peerDependencies": {
    "@nanostores/deepmap": ">=0.0.2",
    "@nanostores/react": ">=1.1.0",
    "@react-aria/utils": ">=3.34.0",
    "lucide-react": ">=1.17.0",
    "motion": ">=12.40.0",
    "nanostores": ">=1.1.0",
    "react": ">=18",
    "react-aria": ">=3.49.0",
    "react-aria-components": ">=1.18.0",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nanostores/deepmap": "^0.0.2",
    "@nanostores/react": "^1.1.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "check-dts": "^0.9.0",
    "eslint": "^9.39.4",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nanostores": "^1.3.0",
    "react": "^18.3.1",
    "react-aria": "^3.49.0",
    "react-aria-components": "^1.18.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
