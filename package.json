{
  "name": "@lifo123/library",
  "version": "1.9.10",
  "description": "Lifo library",
  "type": "module",
  "author": "Lifo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lifo123/lifo-library.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./aria": {
      "types": "./dist/external/aria/index.d.ts",
      "import": "./dist/external/aria/index.js",
      "require": "./dist/external/aria/index.cjs"
    },
    "./aria-components": {
      "types": "./dist/external/aria/components/index.d.ts",
      "import": "./dist/external/aria/components/index.js",
      "require": "./dist/external/aria/components/index.cjs"
    },
    "./aria-utils": {
      "types": "./dist/external/aria/utils/index.d.ts",
      "import": "./dist/external/aria/utils/index.js",
      "require": "./dist/external/aria/utils/index.cjs"
    },
    "./lucide": {
      "types": "./dist/external/lucide/index.d.ts",
      "import": "./dist/external/lucide/index.js",
      "require": "./dist/external/lucide/index.cjs"
    },
    "./motion": {
      "types": "./dist/external/motion/index.d.ts",
      "import": "./dist/external/motion/index.js",
      "require": "./dist/external/motion/index.cjs"
    },
    "./nanoid": {
      "types": "./dist/external/nanoid/index.d.ts",
      "import": "./dist/external/nanoid/index.js",
      "require": "./dist/external/nanoid/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "deploy": "pnpm run build && npm publish --access public"
  },
  "dependencies": {
    "nanoid": "^5.1.11"
  },
  "peerDependencies": {
    "@nanostores/deepmap": ">=0.0.2",
    "@nanostores/react": ">=1.1.0",
    "@react-aria/utils": ">=3.34.0",
    "lucide-react": ">=1.16.0",
    "motion": ">=12.0.0",
    "nanostores": ">=1.1.0",
    "react": ">=18",
    "react-aria": ">=3.44.0",
    "react-aria-components": ">=1.13.0",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nanostores/deepmap": "^0.0.2",
    "@nanostores/react": "^1.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "check-dts": "^0.9.0",
    "eslint": "^9.39.4",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanostores": "^1.3.0",
    "react": "^18.3.1",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
